{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/cadets/:id",
      "destination": "/api/cadets?id=:id"
    },
    {
      "source": "/api/events/:id",
      "destination": "/api/events?id=:id"
    },
    {
      "source": "/api/achievements/:id",
      "destination": "/api/achievements?id=:id"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": ".data/**"
    }
  }
}
